# ── BitGet (existing scalper) ───────────────────────────────────────
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# ── Fyers (NSE/BSE live orders) ─────────────────────────────────────
# Create an app at https://myapi.fyers.in/ to get these.
FYERS_APP_ID=            # e.g. XXXXXX-100
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=https://127.0.0.1/fyers/callback
# Minted by `npm run fyers:auth` — expires daily, do not commit.
FYERS_ACCESS_TOKEN=

# Safety switch: leave as "true" (or unset) to log orders without sending.
# Set to "false" ONLY when you want real fills on the exchange.
FYERS_DRY_RUN=true
