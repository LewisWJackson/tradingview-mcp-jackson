{
  "name": "tradingview-mcp",
  "version": "1.0.0",
  "description": "MCP bridge for TradingView Desktop via Chrome DevTools Protocol",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "tv": "src/cli/index.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./core": "./src/core/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "tv": "node src/cli/index.js",
    "scan": "node scripts/scan-run.js",
    "scan:live": "node scripts/scan-run.js --notify",
    "scan:notify": "node scripts/scan-run.js | node scripts/notify-telegram.js",
    "scan:dry": "node scripts/scan-run.js | node scripts/notify-telegram.js --dry-run",
    "scan:journal": "node scripts/scan-run.js | node scripts/journal-log.js | node scripts/notify-telegram.js",
    "scan:journal:dry": "node scripts/scan-run.js | node scripts/journal-log.js --dry-run | node scripts/notify-telegram.js --dry-run",
    "test": "node --test tests/e2e.test.js tests/pine_analyze.test.js",
    "test:e2e": "node --test tests/e2e.test.js",
    "test:unit": "node --test tests/pine_analyze.test.js tests/cli.test.js tests/journal-log.test.js tests/scan-logic.test.js",
    "test:cli": "node --test tests/cli.test.js",
    "test:journal": "node --test tests/journal-log.test.js",
    "test:scan": "node --test tests/scan-logic.test.js",
    "test:all": "node --test tests/e2e.test.js tests/pine_analyze.test.js tests/cli.test.js tests/journal-log.test.js tests/scan-logic.test.js",
    "test:verbose": "node --test --test-reporter=spec tests/e2e.test.js tests/pine_analyze.test.js",
    "test:count": "node --test --test-reporter=spec tests/e2e.test.js 2>&1 | tail -5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chrome-remote-interface": "^0.33.2",
    "dotenv": "^17.4.1"
  }
}
