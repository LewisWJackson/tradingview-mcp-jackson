//@version=6
// DAY-TYPE ROUTER — the 10:00 filter that decides IF today is an ORB day.
// Research (2026-07-13, BANKNIFTY 15m, 249 days, a-priori thresholds):
//   ORB on TREND days:  n=75  win 76%  avg +92.8pts  PF 2.46
//   ORB on RANGE days:  n=158 win 49%  avg  -7.8pts  PF 0.93  ← all edge gone
// Rule: TREND day = trade ORB per its plan. RANGE day = stand down.
// TREND if first-45-min efficiency >= 0.6 AND (H45-L45) >= 0.25 x ATR14(D).
indicator("DAY-TYPE ROUTER [ORB filter]", overlay = true)

effThresh = input.float(0.6,  "Directional efficiency threshold", step = 0.05)
atrFrac   = input.float(0.25, "First-45m range vs daily ATR",     step = 0.05)

atrD = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)

istMin   = hour(time, "Asia/Kolkata") * 60 + minute(time, "Asia/Kolkata")
barMins  = timeframe.in_seconds() / 60
closeMin = istMin + barMins                     // bar CLOSE time (the time_close lesson)
newDay   = ta.change(time("D")) != 0

var float o915 = na, var float h45 = na, var float l45 = na, var float c45 = na
var float orH = na,  var float orL = na
var string dayType = na
if newDay
    o915 := na, h45 := na, l45 := na, c45 := na, orH := na, orL := na, dayType := na

// accumulate bars fully inside 9:15-10:00
if istMin >= 555 and closeMin <= 600
    o915 := na(o915) ? open : o915
    h45  := na(h45) ? high : math.max(h45, high)
    l45  := na(l45) ? low  : math.min(l45, low)
    c45  := close
// opening range = first 15 minutes
if istMin >= 555 and closeMin <= 570
    orH := na(orH) ? high : math.max(orH, high)
    orL := na(orL) ? low  : math.min(orL, low)

// classify on the first confirmed bar closing at/after 10:00
eff = na(h45) or h45 == l45 ? na : math.abs(c45 - o915) / (h45 - l45)
if na(dayType) and barstate.isconfirmed and closeMin >= 600 and not na(eff) and not na(atrD)
    dayType := eff >= effThresh and (h45 - l45) >= atrFrac * atrD ? "TREND" : "RANGE"
    alert("DAY-TYPE " + syminfo.ticker + ": " + dayType + (dayType == "TREND" ? " — ORB ACTIVE (76% win, PF 2.46)" : " — STAND DOWN (ORB PF 0.93 on range days)"), alert.freq_once_per_bar)

// ── Visuals ─────────────────────────────────────────────────────────
plot(orH, "OR High (15m)", color = color.new(color.teal, 0),   style = plot.style_linebr)
plot(orL, "OR Low (15m)",  color = color.new(color.maroon, 0), style = plot.style_linebr)
bgcolor(dayType == "TREND" ? color.new(color.green, 92) : dayType == "RANGE" ? color.new(color.red, 94) : na)

var table t = table.new(position.top_left, 2, 5, border_color = color.gray, border_width = 1)
if barstate.islast
    hdr = color.new(color.gray, 55)
    vCol = dayType == "TREND" ? color.new(color.green, 60) : dayType == "RANGE" ? color.new(color.red, 60) : color.new(color.gray, 60)
    table.cell(t, 0, 0, "DAY-TYPE ROUTER", text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
    table.cell(t, 1, 0, na(dayType) ? "…classifying (10:00)" : dayType == "TREND" ? "🔥 TREND — ORB ACTIVE" : "😴 RANGE — STAND DOWN", text_color = color.white, bgcolor = vCol, text_size = size.small)
    table.cell(t, 0, 1, "Efficiency (need ≥" + str.tostring(effThresh, "0.0") + ")", text_color = color.white, bgcolor = hdr, text_size = size.small)
    table.cell(t, 1, 1, na(eff) ? "—" : str.tostring(eff, "0.00"), text_color = color.white, bgcolor = na(eff) ? hdr : eff >= effThresh ? color.new(color.green, 70) : color.new(color.red, 70), text_size = size.small)
    table.cell(t, 0, 2, "45m range vs ATR (need ≥" + str.tostring(atrFrac * 100, "0") + "%)", text_color = color.white, bgcolor = hdr, text_size = size.small)
    table.cell(t, 1, 2, na(h45) or na(atrD) ? "—" : str.tostring((h45 - l45) / atrD * 100, "0") + "%", text_color = color.white, bgcolor = na(h45) or na(atrD) ? hdr : (h45 - l45) >= atrFrac * atrD ? color.new(color.green, 70) : color.new(color.red, 70), text_size = size.small)
    table.cell(t, 0, 3, "OR levels (ORB entries)", text_color = color.white, bgcolor = hdr, text_size = size.small)
    table.cell(t, 1, 3, na(orH) ? "—" : str.tostring(orH, format.mintick) + " / " + str.tostring(orL, format.mintick), text_color = color.white, bgcolor = hdr, text_size = size.small)
    table.cell(t, 0, 4, "Verified (249d)", text_color = color.white, bgcolor = hdr, text_size = size.small)
    table.cell(t, 1, 4, "TREND: 76% PF 2.46 · RANGE: PF 0.93", text_color = color.new(color.orange, 0), bgcolor = hdr, text_size = size.small)
